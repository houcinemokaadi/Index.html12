<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Cours & Exercices : Les Fractions</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            line-height: 1.6;
            margin: 0;
            padding: 20px;
            background-color: #f4f6f9;
            color: #333;
        }
        .container {
            max-width: 800px;
            margin: auto;
            background: white;
            padding: 25px;
            border-radius: 8px;
            box-shadow: 0 2px 5px rgba(0,0,0,0.1);
        }
        header {
            background-color: #2c3e50;
            color: white;
            text-align: center;
            padding: 20px;
            border-radius: 8px;
            margin-bottom: 25px;
        }
        h1 { margin: 0; }
        h2 {
            color: #2980b9;
            border-bottom: 2px solid #2980b9;
            padding-bottom: 5px;
        }
        .fraction {
            display: inline-flex;
            flex-direction: column;
            vertical-align: middle;
            text-align: center;
            font-weight: bold;
            font-size: 1.1em;
            margin: 0 4px;
        }
        .fraction .num { border-bottom: 2px solid #333; padding: 0 3px; }
        .fraction .den { padding: 0 3px; }
        
        /* Style des exercices interactifs */
        .card {
            background-color: #fff;
            border: 1px solid #e0e0e0;
            border-left: 5px solid #3498db;
            padding: 15px;
            margin: 15px 0;
            border-radius: 4px;
        }
        .options { margin: 10px 0; }
        .options label { display: block; margin: 5px 0; cursor: pointer; }
        input[type="number"] {
            width: 60px;
            padding: 5px;
            text-align: center;
            font-size: 1em;
        }
        button {
            background-color: #27ae60;
            color: white;
            border: none;
            padding: 8px 15px;
            border-radius: 4px;
            cursor: pointer;
            font-size: 0.9em;
            margin-top: 8px;
        }
        button:hover { background-color: #219150; }
        .feedback {
            margin-top: 10px;
            font-weight: bold;
        }
        .correct { color: #27ae60; }
        .incorrect { color: #c0392b; }
    </style>
</head>
<body>

<div class="container">
    <header>
        <h1>Mathématiques : Les Fractions</h1>
        <p>Exercices interactifs d'application</p>
    </header>

    <section>
        <h2>Exercice 1 : QCM (Addition)</h2>
        <div class="card">
            <p><strong>Question :</strong> Calculez l'opération suivante :</p>
            <p style="font-size: 1.2em;">
                <span class="fraction"><span class="num">2</span><span class="den">7</span></span> + 
                <span class="fraction"><span class="num">3</span><span class="den">7</span></span> = ?
            </p>
            <div class="options">
                <label><input type="radio" name="q1" value="a"> A) <span class="fraction"><span class="num">5</span><span class="den">14</span></span></label>
                <label><input type="radio" name="q1" value="b"> B) <span class="fraction"><span class="num">5</span><span class="den">7</span></span></label>
                <label><input type="radio" name="q1" value="c"> C) <span class="fraction"><span class="num">6</span><span class="den">7</span></span></label>
            </div>
            <button onclick="verifierQ1()">Vérifier la réponse</button>
            <div id="res-q1" class="feedback"></div>
        </div>
    </section>

    <section>
        <h2>Exercice 2 : Compléter le calcul (Multiplication)</h2>
        <div class="card">
            <p><strong>Question :</strong> Effectuez la multiplication :</p>
            <p style="font-size: 1.2em;">
                <span class="fraction"><span class="num">3</span><span class="den">4</span></span> × 
                <span class="fraction"><span class="num">2</span><span class="den">5</span></span> = 
                <span class="fraction">
                    <span class="num"><input type="number" id="num-q2"></span>
                    <span class="den"><input type="number" id="den-q2"></span>
                </span>
            </p>
            <button onclick="verifierQ2()">Vérifier la réponse</button>
            <div id="res-q2" class="feedback"></div>
        </div>
    </section>

    <footer>
        <p style="text-align: center; color: #777;">— Exercices interactifs de mathématiques —</p>
    </footer>
</div>

<script>
    function verifierQ1() {
        const reponse = document.querySelector('input[name="q1"]:checked');
        const feedback = document.getElementById('res-q1');
        
        if (!reponse) {
            feedback.textContent = "Veuillez sélectionner une réponse.";
            feedback.className = "feedback incorrect";
            return;
        }

        if (reponse.value === 'b') {
            feedback.textContent = "Bravo ! Quand les dénominateurs sont identiques, on additionne les numérateurs.";
            feedback.className = "feedback correct";
        } else {
            feedback.textContent = "Incorrect. Rappel : on n'additionne pas les dénominateurs entre eux !";
            feedback.className = "feedback incorrect";
        }
    }

    function verifierQ2() {
        const num = document.getElementById('num-q2').value;
        const den = document.getElementById('den-q2').value;
        const feedback = document.getElementById('res-q2');

        if (num === "" || den === "") {
            feedback.textContent = "Veuillez remplir le numérateur et le dénominateur.";
            feedback.className = "feedback incorrect";
            return;
        }

        if (parseInt(num) === 6 && parseInt(den) === 20) {
            feedback.textContent = "Très bien ! 3 × 2 = 6 et 4 × 5 = 20.";
            feedback.className = "feedback correct";
        } else {
            feedback.textContent = "Incorrect. Pour multiplier : multipliez les numérateurs entre eux, puis les dénominateurs entre eux.";
            feedback.className = "feedback incorrect";
        }
    }
</script>

</body>
</html>
